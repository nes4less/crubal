{
  "name": "@cruba/crubal-host",
  "version": "0.3.29",
  "description": "The reference CRUBAL host: identity, secrets, adapters, signing, the loops, the platform index and the HTTP surface over the Postgres store.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "crubal-host": "dist/bin/crubal-host.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/schema.sql dist/src/",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@cruba/crubal": "0.3.29",
    "@cruba/crubal-postgres": "0.3.29",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nes4less/crubal.git",
    "directory": "packages/crubal-host"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Chris Thompson"
}
