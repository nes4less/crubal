{
  "name": "@cruba/crubal",
  "version": "0.1.5",
  "description": "The CRUBAL reference implementation: read, print, check and run CRUBAL, a language and engine for data about any kind of thing.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "default": "./dist/src/browser.js"
    }
  },
  "bin": {
    "crubal": "./dist/bin/crubal.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "corpus": "node bin/crubal.ts test ../../corpus --level views",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "embed": "node scripts/embed-std.mjs",
    "units": "node scripts/embed-std.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nes4less/crubal.git",
    "directory": "packages/crubal"
  },
  "homepage": "https://github.com/nes4less/crubal#readme",
  "keywords": [
    "crubal",
    "facets",
    "data",
    "schema",
    "provenance",
    "catalog",
    "conformance"
  ],
  "author": "Chris Thompson",
  "publishConfig": {
    "access": "public"
  }
}
