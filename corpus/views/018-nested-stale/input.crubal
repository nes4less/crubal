// A page row is stale when its nested view gains or loses a record (chapter 12.6): a new Blu-ray of W-2
// stales Home Alone's page, and nothing else; the pages of W-1 read nothing the write touches.
view: pages

shape: productPage
  slots:
    title -> heading
    view:alsoOn -> alsoOn

view: alsoOn
  select:
    level: product
  of: work is context.work and not id is context.id
  shape: card

view: pages
  select:
    level: product
  shape: productPage

crubal: 2
package: test /2026-10-14
owner: test.example

product: P-10 [origin: declared, via: L-1]
  title: Christmas Vacation
  format: DVD
  releaseDate: 1989
  work: &W-1

product: P-11 [origin: declared, via: L-1]
  title: Christmas Vacation
  format: Blu-ray
  releaseDate: 2010
  work: &W-1

product: P-12 [origin: declared, via: L-1]
  title: Home Alone
  format: DVD
  releaseDate: 1990
  work: &W-2
