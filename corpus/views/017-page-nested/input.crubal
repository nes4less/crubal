// A page shape's slot may hold another view (chapter 12.1), run with the page's record as its context:
// each product page carries "also on other formats" under its slot, and a page with none has no slot.
view: pages

shape: productPage
  slots:
    title -> heading
    view:alsoOn -> alsoOn

view: alsoOn
  select:
    level: product
  of: work is context.work and not id is context.id
  shape: card

view: pages
  select:
    level: product
  shape: productPage

crubal: 2
package: test /2026-10-14
owner: test.example

product: P-10 [origin: declared, via: L-1]
  title: Christmas Vacation
  format: DVD
  releaseDate: 1989
  work: &W-1

product: P-11 [origin: declared, via: L-1]
  title: Christmas Vacation
  format: Blu-ray
  releaseDate: 2010
  work: &W-1

product: P-12 [origin: declared, via: L-1]
  title: Home Alone
  format: DVD
  releaseDate: 1990
  work: &W-2
