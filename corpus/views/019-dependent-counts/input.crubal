// A filter's dependent facets (chapter 12.3, 11.2 follows) are counted inside each of its buckets: the
// labels of each edition, narrowed by the other filters' picks like the counts themselves.
view: editions
pick:
  genres: Comedy

edition{Theatrical|Special}
label{Fox|Universal}

filter: edition
  facet: edition
  dependent: label

view: editions
  select:
    level: product
  shape: card
  filters: edition, genres

crubal: 2
package: test /2026-10-14
owner: test.example

product: P-1 [origin: declared, via: L-1]
  title: Christmas Vacation
  format: DVD
  releaseDate: 1989
  genres: Comedy
  edition: Theatrical
  label: Fox

product: P-2 [origin: declared, via: L-1]
  title: Home Alone
  format: Blu-ray
  releaseDate: 1990
  genres: Comedy
  edition: Special
  label: Fox

product: P-3 [origin: declared, via: L-1]
  title: Die Hard
  format: 4K
  releaseDate: 1988
  genres: Drama
  edition: Special
  label: Universal

product: P-4 [origin: declared, via: L-1]
  title: Elf
  format: DVD
  releaseDate: 2003
  genres: Comedy
  edition: Special
  label: Universal
