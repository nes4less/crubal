// Facet definitions the dictionary cases use.
title$80 ~name
format{DVD~"DVD Video"|Blu-ray~BD~Bluray|4K} ~"Video Format" ~videoFormat
releaseDate@ym
runtime#min 1..600 accepts: h
genres{Comedy|Holiday|Drama|...}*
region{A|B|C} fixed
discs#
languages$*2

// For the class cases.
videoCodec{MPEG-2|H.264|VC-1|HEVC|AV1}
discCondition{NM|VG|G|F|P} ranked

// Times.
ends@ymdhm
lastCall@hm
wallClock@ymdhm zone: local
