// Sharing is offer plus take: only the overlap flows (chapter 7.8). The presenter offers title, format and
// runtime; the consumer takes title, runtime and price. A person's value on the consumer's side is never
// overridden: the presenter's title is kept as an alternative.
contract: catalogOffer
  kind: offer
  gives: title, format, runtime
  to: public
  mode: gathered

contract: catalogTake
  kind: take
  from: distributor.example
  reads:
    title -> title
    runtime -> runtime
    price -> price
  mode: gathered

crubal: 2
package: test /2026-10-14
owner: test.example

product: P-4 [origin: declared, via: L-1]
  title: Xmas Vacation
