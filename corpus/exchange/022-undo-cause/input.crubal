// Undo (7.5): running the contract that reverses a run is an ordinary send naming its cause.
contract: list
  kind: send
  writes:
    title -> Title
  undo: unlist

contract: unlist
  kind: send
  writes:
    title -> Title
crubal: 2
package: test /2026-10-14
owner: test.example

product: P-1 [origin: declared, via: L-1]
  title: Christmas Vacation
  format: DVD
