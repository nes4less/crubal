// A store contract (7.1, 7.3) is one map read both ways: written, ourAddress -> theirField; read, the same
// lines the other way, value maps too. Sending maps out through it; an answer naming the run lands through it.
shelf$
slot$
contract: location
  kind: store
  origin: declared
  stores:
    shelf -> bin.shelf
      A -> "Aisle A"
    slot -> bin.slot
crubal: 2
package: test /2026-10-14
owner: test.example

unit: U-1 [origin: reported, via: L-1]
  shelf: A
  slot: 4
