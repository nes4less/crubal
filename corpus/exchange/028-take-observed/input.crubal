// observed (7.8): a read-through is never stored. The record links to the presenter's record, naming
// what it reads; no value is copied.
contract: catalogOffer
  kind: offer
  gives: title, format, runtime
  to: public
  mode: observed

contract: catalogTake
  kind: take
  from: distributor.example
  reads:
    title -> title
    runtime -> runtime
  mode: observed

crubal: 2
package: test /2026-10-14
owner: test.example

product: P-4 [origin: declared, via: L-1]
  title: Xmas Vacation
