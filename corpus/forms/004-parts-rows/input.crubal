// Parts come as rows per slot of the record's worn classes (5.6), the slot's class lines as the fields.
contract: inspect
  kind: form
  origin: observed
  needs:
    !title
crubal: 2
package: test /2026-10-14
owner: test.example

product: P-1 [origin: declared, via: L-1]
  crubal:wears: BoxSet
  title: Christmas Vacation
  crubal:parts:
    - [row: disc1]
      crubal:wears: Disc
      discFormat: DVD-9
    - [row: disc2]
      crubal:wears: Disc
      discFormat: DVD-5
      condition: G
