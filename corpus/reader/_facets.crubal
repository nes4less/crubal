// Facet definitions, in chapter 4's shorthand and long form.
title$
subtitle$
format{DVD|Blu-ray|4K}
releaseDate@any
discs#
runtime#min
weight#lb
price#USD
sealed?
videoCodec{MPEG-2|H.264|VC-1|HEVC|AV1}
hdrFormats{HDR10|Dolby Vision|...}*
genres{Comedy|Holiday|Drama|...}*
work&Work
director&Person
homepage&url
cover^
region{US|UK|...}
rating{G|PG|PG-13|R|15|...}* qualifiers: region
condition{NM|VG|G|F|P} ranked
discFormat{DVD-5|DVD-9|BD-25|BD-50}
note$

// Long forms the shorthand has no mark for.
facet: cast
  type: compound
  pick: any
  ordered: yes
  identity: person
  facets:
    person&Person
    character$

facet: tracks
  type: compound
  pick: any
  ordered: yes
  facets:
    language$
    channels#

facet: aliasesSeen
  type: text
  pick: any
  ordered: yes

// Dates with a time, times of day.
auctionEnds@ymdhm
opens@hm qualifiers: zone
zone$
doorsOpen@ymdhm zone: local
