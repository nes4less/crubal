// Landing parts (9.2, 5.6): a row named binds by its key; an unnamed one binds by the slot's match child, else is
// minted; each value lands on its part at parts[row].key under the trust order, the loser an alternative.
facet: name
  type: text
class: Disc
  facets:
    name
    condition
class: BoxSet
  for: item
  facets:
    title
  parts:
    disc: Disc * match: name
crubal: 2
package: test /2026-10-14
owner: test.example

product: P-1 [origin: declared, via: L-1]
  crubal:wears: BoxSet
  title: Christmas Vacation
  crubal:parts:
    - [row: disc1]
      crubal:wears: Disc
      name: Disc 1
      condition: NM
