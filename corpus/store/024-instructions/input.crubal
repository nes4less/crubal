// Instructions (10.7): a product and a class version change which keys units hold. Nothing reaches a unit
// until it applies them; U-1 applies, U-2 stays as it was, pending.
graded?
grade{Graded|Ungraded}

class: Disc
  for: item
  facets:
    title
    unit::sealed

crubal: 2
package: test /2026-10-14
owner: test.example

product: P-1 [origin: declared, via: L-1]
  crubal:wears: Disc
  title: Christmas Vacation

unit: U-1 of P-1 [origin: observed, via: L-2]
  graded: yes
  sealed: no
  price: 12.50USD

unit: U-2 of P-1 [origin: observed, via: L-2]
  graded: no
  sealed: yes
  price: 8.00USD
