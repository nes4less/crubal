// Incoming parts (9.2, 5.6): the body's `parts` list, each a slot, an optional row and the part's values; a value
// is read under its facet and carries which part it belongs to.
facet: name
  type: text
class: Disc
  facets:
    name
    condition
class: BoxSet
  for: item
  facets:
    title
  parts:
    disc: Disc * match: name
crubal: 2
package: test /2026-10-14
owner: test.example

product: P-1 [origin: declared, via: L-1]
  crubal:wears: BoxSet
  title: Christmas Vacation
  crubal:parts:
    - [row: disc1]
      crubal:wears: Disc
      name: Disc 1
      condition: NM
